{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "outDir": "./dist",           // ✅ Add this
    "rootDir": "./src",     
    "types": [],       // ✅ Add this for clean output structure
    "declaration": true,           // Optional: generate .d.ts files
    "declarationMap": true         // Optional: for better IDE support
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}